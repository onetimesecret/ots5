# OneTimeSecret Configuration

# Redis Connection
OTS_REDIS_URL=redis://localhost:6379/0

# Security Settings
# IMPORTANT: Generate a secure secret key using: python -c "import secrets; print(secrets.token_urlsafe(32))"
OTS_SECRET_KEY=CHANGE_ME_TO_SECURE_RANDOM_KEY

# SSL/TLS
OTS_SSL_ENABLED=false

# Authentication
OTS_AUTH_REQUIRED=false
OTS_PASSPHRASE_REQUIRED=false

# Application Settings
OTS_MAX_SECRET_SIZE=1048576
OTS_DEFAULT_TTL=604800
OTS_MAX_TTL=2592000

# API Settings
OTS_API_PREFIX=/api/v2
OTS_CORS_ORIGINS=["*"]

# Server Settings
OTS_HOST=0.0.0.0
OTS_PORT=8000
OTS_DEBUG=false
