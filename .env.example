# OneTimeSecret Environment Configuration
# Copy this file to .env and update with your settings

# ============================================================================
# SECURITY - CRITICAL: CHANGE THESE IN PRODUCTION!
# ============================================================================
# Generate with: openssl rand -hex 32
SECRET_KEY=change-this-to-a-secure-random-key-minimum-32-chars-long-please

# SSL/TLS (REQUIRED in production)
SSL_ENABLED=true

# ============================================================================
# APPLICATION
# ============================================================================
APP_NAME=OneTimeSecret
APP_VERSION=3.0.0
ENVIRONMENT=production
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4
RELOAD=false

# ============================================================================
# DATABASE
# ============================================================================
DATABASE_URL=postgresql+asyncpg://ots:ots_password@localhost:5432/onetimesecret
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ============================================================================
# REDIS
# ============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50

# ============================================================================
# CELERY (Background Tasks)
# ============================================================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ============================================================================
# SECURITY SETTINGS
# ============================================================================
AUTH_REQUIRED=false
PASSPHRASE_REQUIRED=false

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ============================================================================
# SECRET CONFIGURATION
# ============================================================================
DEFAULT_TTL=3600
MAX_TTL=259200
MIN_TTL=300
MAX_SECRET_SIZE=1048576

# Allowed TTL options (30m, 12h, 24h, 3d in seconds)
ALLOWED_TTLS=1800,43200,86400,259200

# ============================================================================
# EMAIL (Optional)
# ============================================================================
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@onetimesecret.com

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
